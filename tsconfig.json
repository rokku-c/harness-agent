{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["bun-types"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@effect-agent/core": ["./packages/core/src/index.ts"],
      "@effect-agent/builtin": ["./packages/builtin/src/index.ts"]
    }
  },
  "include": ["packages/core/src/**/*.ts", "packages/builtin/src/**/*.ts", "test/**/*.ts", "examples/**/*.ts", "scripts/**/*.ts"]
}
