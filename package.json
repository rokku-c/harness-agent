{
  "name": "effect-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.4",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "examples": "bun scripts/run-examples.ts",
    "examples:live": "bun scripts/run-examples.ts --live",
    "dogfood": "bun scripts/dogfood-agent.ts",
    "codex:session": "bun scripts/codex-session.ts",
    "mantis:pm2:start": "pm2 start apps/mantis/ecosystem.config.cjs",
    "mantis:pm2:robot": "pm2 start apps/mantis/ecosystem.config.cjs --only mantis-robot",
    "mantis:pm2:dws": "pm2 start apps/mantis/ecosystem.config.cjs --only mantis-dws",
    "mantis:pm2:restart": "pm2 restart apps/mantis/ecosystem.config.cjs",
    "mantis:pm2:stop": "pm2 stop apps/mantis/ecosystem.config.cjs",
    "mantis:pm2:logs": "pm2 logs mantis-robot mantis-dws",
    "lint:lines": "bun scripts/check-lines.ts",
    "check:boundary": "bun scripts/check-boundary.ts",
    "check:pages": "bun scripts/check-html-pages.ts",
    "check:ui": "bun scripts/check-ui.ts",
    "check:proofs": "bun scripts/check-proofs.ts",
    "inventory": "bun scripts/inventory-apps.ts",
    "check:inventory": "bun scripts/inventory-apps.ts --check",
    "up": "bun apps/effect-server/src/up.ts",
    "up:dev": "EFFECT_DEV=1 bun apps/effect-server/src/up.ts",
    "app:host": "bun scripts/host-app.ts",
    "node:probe": "bun scripts/agentd-probe.ts",
    "kernel:build": "bun scripts/build-kernel.ts",
    "config:rebuild": "bun scripts/rebuild-config.ts"
  },
  "devDependencies": {
    "pm2": "^7.0.4"
  }
}
